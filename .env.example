# ==============================================================================
# Environment Configuration — Dell OptiPlex Homelab (i5-3470 / 8GB RAM / 3TB HDD)
# Copy this file to .env before running `docker compose up -d`
# ==============================================================================

TZ=America/Sao_Paulo
HOMELAB_LAN_IP=192.168.1.250

# Pi-hole Network Adblocker
PIHOLE_WEB_PORT=8080
PIHOLE_PASSWORD=change_this_pihole_pass

# Samba (SMB3) & FileBrowser (3TB HDD Storage)
SMB_USER=pedro
SMB_PASSWORD=change_this_smb_pass
FILEBROWSER_PORT=8081

# Minecraft PaperMC Server (4GB Heap out of 8GB Total System RAM)
MC_VERSION=LATEST
MC_MAX_PLAYERS=10
MC_VIEW_DISTANCE=8
MC_SIM_DISTANCE=6
MC_ONLINE_MODE=true
MC_RCON_PASSWORD=change_this_rcon_pass
