# ==============================================================================
# Environment Configuration — Dell OptiPlex LGA 1155 Homelab (i5-3470 / 8GB / 3TB)
# Copy this file to .env before running `docker compose up -d`
# ==============================================================================

TZ=America/Sao_Paulo
HOMELAB_LAN_IP=192.168.1.250

# 1. Pi-hole Network Adblocker
PIHOLE_WEB_PORT=8080
PIHOLE_PASSWORD=change_this_pihole_pass

# 2. Samba (SMB3) & FileBrowser (3TB HDD Storage)
SMB_USER=pedro
SMB_PASSWORD=change_this_smb_pass
FILEBROWSER_PORT=8081

# 3. Immich (Self-Hosted Google Photos on /mnt/storage3tb/photos)
IMMICH_VERSION=release
IMMICH_PORT=2283
IMMICH_DB_PASSWORD=change_this_immich_db_pass

# 4. Jellyfin (Media Server) & Navidrome (Music Server)
JELLYFIN_PORT=8096
NAVIDROME_PORT=4533

# 5. Minecraft PaperMC Server (3.5GB Heap so Immich + Jellyfin + Samba fit in 8GB RAM)
MC_VERSION=LATEST
MC_HEAP=3584M
MC_MAX_PLAYERS=10
MC_VIEW_DISTANCE=8
MC_SIM_DISTANCE=6
MC_ONLINE_MODE=true
MC_RCON_PASSWORD=change_this_rcon_pass
